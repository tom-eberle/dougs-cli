{
  "name": "dougs-cli",
  "version": "0.1.1",
  "description": "Unofficial command-line client for the Dougs accounting platform, built for humans and AI agents",
  "keywords": [
    "dougs",
    "accounting",
    "comptabilite",
    "tva",
    "vat",
    "cli",
    "agents"
  ],
  "homepage": "https://github.com/tom-eberle/dougs-cli#readme",
  "bugs": {
    "url": "https://github.com/tom-eberle/dougs-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tom-eberle/dougs-cli.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "dougs": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsup",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "diagrams": "node docs/diagrams/build.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "unpdf": "^1.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.13.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
